#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$root/scripts/validate_manifest.py" "$root"
bash -n "$root/demo/run"
python3 -m json.tool "$root/demo/fixtures/example.json" >/dev/null

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

qml_formatter="$(command -v qmlformat || true)"
if [[ -z "$qml_formatter" && -x /usr/lib/qt6/bin/qmlformat ]]; then qml_formatter=/usr/lib/qt6/bin/qmlformat; fi
if [[ -n "$qml_formatter" ]]; then
  for source in "$root"/*.qml; do QT_FORCE_STDERR_LOGGING=1 "$qml_formatter" -n "$source" >/dev/null; done
fi

PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s "$root/tests" -p "test_*.py"
node --test "$root/tests/model.test.cjs"

qt_runner="$(command -v qmltestrunner || true)"
if [[ -z "$qt_runner" && -x /usr/lib/qt6/bin/qmltestrunner ]]; then qt_runner=/usr/lib/qt6/bin/qmltestrunner; fi
if [[ -n "$qt_runner" ]]; then
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software "$qt_runner" -input "$root/tests/qml" -import "$root/tests/qml/imports" -o -,txt
elif [[ "${PCS_REQUIRE_QT:-0}" == "1" ]]; then
  printf 'QtTest is required for this check but was not found.\n' >&2
  exit 1
else
  printf 'QtTest unavailable; service integration tests skipped.\n'
fi

printf 'All portable plugin checks passed.\n'
