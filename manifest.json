{
  "schemaVersion": 1,
  "id": "io.github.vip32.procyclingstats",
  "name": "ProCyclingStats",
  "version": "0.2.0",
  "author": "vip32",
  "license": "MIT",
  "description": "Professional road cycling races and live race situation.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "ProCyclingStats",
    "description": "Professional road cycling races and live race situation.",
    "category": "Other",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "refreshIntervalSec": 60
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Live refresh interval (seconds)",
        "min": 60,
        "max": 900,
        "step": 30,
        "defaultValue": 60
      }
    ]
  }
}
